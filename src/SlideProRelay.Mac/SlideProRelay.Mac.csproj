<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The macOS app only builds on macOS: net10.0-macos needs Apple tooling that
    doesn't exist on Windows/Linux. To keep "Build Solution" / `dotnet build`
    green cross-platform, on non-macOS hosts this project degrades to an empty
    net10.0 stub (no sources, no ProjectReference) instead of failing the build.
    On macOS it builds exactly as before.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>SlideProRelay</AssemblyName>
    <RootNamespace>SlideProRelay.Mac</RootNamespace>
    <ApplicationId>io.slidepro.relay</ApplicationId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Stub: compile nothing so AppKit-dependent sources don't break the build. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ProjectReference Include="..\SlideProRelay.Server\SlideProRelay.Server.csproj" />
  </ItemGroup>

</Project>
