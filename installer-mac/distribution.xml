<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">

    <title>SlideProRelay</title>
    <welcome    file="welcome.html"    mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <options
        customize="never"
        require-scripts="false"
        rootVolumeOnly="false"
        allow-external-scripts="false"/>

    <pkg-ref id="io.slidepro.relay"/>

    <choices-outline>
        <line choice="default">
            <line choice="io.slidepro.relay"/>
        </line>
    </choices-outline>

    <choice id="default"/>
    <choice id="io.slidepro.relay" visible="false">
        <pkg-ref id="io.slidepro.relay"/>
    </choice>

    <pkg-ref
        id="io.slidepro.relay"
        version="$(PRODUCT_VERSION)"
        onConclusion="none">SlideProRelay-component.pkg</pkg-ref>

</installer-gui-script>
